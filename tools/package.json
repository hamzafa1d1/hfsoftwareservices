{
  "name": "hf-portfolio-tools",
  "private": true,
  "description": "Build step for the 3D scene only. The site itself stays static.",
  "scripts": {
    "build:scene": "rm -rf ../assets/js && NODE_PATH=./node_modules esbuild ../src/main.js ../src/scene.js --bundle --splitting --minify --format=esm --target=es2020 --outdir=../assets/js --entry-names=[name] --chunk-names=chunks/[name]-[hash] --legal-comments=none"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "gsap": "3.15.0",
    "three": "0.187.0"
  }
}
